{
  "_comment": "1TB/2TB 容量适配压力 case。case_id 形如 AI-TRN-003-1TB：base 是 case_catalog.json 中的原始 case，overrides 是 run_case 缩小/放大参数（Training 按盘容量调 dataset.num_files_train）。默认单盘运行（run_case 自动加 --skip-fs-separation-gate）。",
  "1TB": {
    "_comment": "1TB SSD ≈ 931 GiB 可用；压力目标：训练数据填盘 ~50% + checkpoint 多轮写读 + 向量全量搜索",
    "AI-TRN-003-1TB": { "base": "AI-TRN-003", "overrides": ["--num-files-train", "3500"] },
    "AI-TRN-004-1TB": { "base": "AI-TRN-004", "overrides": [] },
    "AI-CKP-001-1TB": { "base": "AI-CKP-001", "overrides": ["--num-checkpoints-write", "10", "--num-checkpoints-read", "10"] },
    "AI-KV-007-1TB":  { "base": "AI-KV-007",  "overrides": ["--duration-sec", "300", "--trials", "3"] },
    "AI-VDB-002-1TB": { "base": "AI-VDB-002", "overrides": ["--duration-sec", "120"] }
  },
  "2TB": {
    "_comment": "2TB SSD ≈ 1862 GiB 可用；压力目标：unet3d 正式数据集 + 70B checkpoint 大写入 + 10M 向量",
    "AI-TRN-003-2TB": { "base": "AI-TRN-003", "overrides": ["--num-files-train", "7200"] },
    "AI-TRN-004-2TB": { "base": "AI-TRN-004", "overrides": [] },
    "AI-CKP-002-2TB": { "base": "AI-CKP-002", "overrides": ["--num-processes", "8", "--num-checkpoints-write", "10", "--num-checkpoints-read", "10"] },
    "AI-KV-008-2TB":  { "base": "AI-KV-008",  "overrides": ["--duration-sec", "300", "--trials", "3"] },
    "AI-VDB-006-2TB": { "base": "AI-VDB-006", "overrides": ["--duration-sec", "120"] }
  }
}
